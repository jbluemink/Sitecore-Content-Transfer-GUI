<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="SitecoreContentTransfer.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SitecoreContentTransfer"
    xmlns:converters="using:SitecoreContentTransfer.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <converters:EnumToIntConverter x:Key="EnumToIntConverter"/>
            <converters:ConnectionTypeToVisibilityConverter x:Key="ConnectionTypeToVisibilityConverter"/>
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
            <converters:InverseBoolConverter x:Key="InverseBoolConverter"/>
            <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
            <converters:BoolToColorConverter x:Key="BoolToColorConverter"/>
            <converters:HasItemsConverter x:Key="HasItemsConverter"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
